# Safe production defaults. Set DEBUG_MODE=true only while troubleshooting locally.
DEBUG_MODE=false

# The API should normally be exposed through a TLS reverse proxy, not directly.
API_HOST=127.0.0.1
API_PORT=7650
WORKER_NUM=1
LOG_FILE=/var/log/plexdns/bind9-api.log
PID_FILE=/run/bind9-api/bind9-api.pid
BACKUP_DIR=/var/lib/bind9-api/backups

# BIND paths. The Red Hat installation section documents its different paths.
BIND9_ZONE_DIR=/etc/bind/zones
BIND9_CONF_FILE=/etc/bind/bind9-api.conf
BIND9_MAIN_CONF=/etc/bind/named.conf
BIND9_SLAVE_DIR=/var/cache/bind
RNDC_BIN=/usr/sbin/rndc
NAMED_CHECKCONF_BIN=/usr/sbin/named-checkconf
NAMED_CHECKZONE_BIN=/usr/sbin/named-checkzone
BIND9_VALIDATE=true

# Default SOA values.
SOA_EMAIL=hostmaster.example.com.
REFRESH=7200
RETRY=3600
EXPIRE=1209600
MIN_TTL=86400

# Add up to NS13. Values must be absolute names with a trailing dot.
NS1=ns1.example.com.
NS2=ns2.example.com.

# Database driver: sqlite or mysql (MariaDB uses mysql).
DB_TYPE=sqlite

# SQLite settings. DB_DATABASE must be an absolute path.
DB_DATABASE=/var/lib/bind9-api/bind9_api.sqlite
DB_BUSY_TIMEOUT=5000

# MariaDB/MySQL settings. They are ignored when DB_TYPE=sqlite.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=bind9_api
DB_PASSWORD=replace-with-a-long-random-password

# Authentication sessions.
SESSION_TTL=3600
SESSION_BIND_IP=true

# Comma-separated reverse-proxy IPs allowed to supply X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1

# Login and API rate limiting. Whitelisted IPs bypass this limiter.
RATELY=true
LOGIN_RATE_LIMIT=10
RATE_LIMIT=120
RATE_PERIOD=60
